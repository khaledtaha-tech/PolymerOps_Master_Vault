# ==============================================================================
# PolymerOps Master Vault - Unified Environment Configuration Template
# Target Domain: https://master.polymerops.com
# INSTRUCTIONS: Copy to .env and fill in your production values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Domain Environment
# ------------------------------------------------------------------------------
APP_ENV=production
APP_URL=https://master.polymerops.com
ALLOW_REGISTRATION=false
POLYMER_SESSION_NAME=polymerops_master_session

# ------------------------------------------------------------------------------
# 2. Relational Database Connection (Hostinger MySQL / MariaDB)
# ------------------------------------------------------------------------------
POLYMER_DB_HOST=localhost
POLYMER_DB_PORT=3306
POLYMER_DB_NAME=u976858450_master_vault
POLYMER_DB_USER=u976858450_master_vault
POLYMER_DB_PASS=
POLYMER_DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 3. Vault Cryptography & Master Application Key (AES-256-GCM)
# Must be at least 32 high-entropy characters. Do not change once secrets are stored!
# ------------------------------------------------------------------------------
POLYMER_APP_KEY=CHANGE_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# ------------------------------------------------------------------------------
# 4. Google Identity Services & OAuth 2.0 Web SSO
# Console Callback: https://master.polymerops.com/auth.php?action=google_callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://master.polymerops.com/auth.php?action=google_callback
ALLOWED_EMAILS=khaled.taha.pro@gmail.com

# ------------------------------------------------------------------------------
# 5. Hostinger SMTP Outbound Mail Configuration (Password Resets)
# Host: smtp.hostinger.com | Port 465 (SSL) or Port 587 (TLS)
# ------------------------------------------------------------------------------
SMTP_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@polymerops.com
SMTP_FROM_NAME="PolymerOps Master Vault"
RESET_EMAIL_FROM=noreply@polymerops.com

# ------------------------------------------------------------------------------
# 6. GitHub Reconnaissance & DevOps API
# GitHub Personal Access Token (Classic with 'repo' scope or Fine-Grained token)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE

# ------------------------------------------------------------------------------
# 7. Migration & Administration Security Key
# Guard token for HTTP invocation of tools/migrate.php
# ------------------------------------------------------------------------------
POLYMER_MIGRATION_KEY=CHANGE_TO_A_SECURE_MIGRATION_SECRET_KEY

# ------------------------------------------------------------------------------
# 8. Optional Legacy Database Import (Secondary Legacy Source)
# ------------------------------------------------------------------------------
POLYMER_LEGACY_DB_HOST=localhost
POLYMER_LEGACY_DB_PORT=3306
POLYMER_LEGACY_DB_NAME=
POLYMER_LEGACY_DB_USER=
POLYMER_LEGACY_DB_PASS=
POLYMER_LEGACY_APP_KEY=
